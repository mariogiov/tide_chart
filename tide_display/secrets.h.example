/*
 * secrets.h.example — template. Do NOT put real credentials in this file.
 *
 * Setup:
 *   1. Copy this file to `secrets.h` in the same folder.
 *   2. Fill in your real values there.
 *
 * `secrets.h` is listed in .gitignore, so it stays on your machine.
 * This .example file IS committed, so the repo documents what's needed.
 */

#pragma once

// ---- WiFi -----------------------------------------------------------------
// 2.4 GHz only. The ESP32 cannot see 5 GHz networks at all -- if your
// router advertises both under one name, this usually still works, but a
// 5 GHz-only network will just never connect.

#define WIFI_SSID  "your-network-name"
#define WIFI_PASS  "your-password"

// ---- Where tide.bin lives -------------------------------------------------
// GitHub Actions publishing to the `data` branch (HTTPS):
//   "https://raw.githubusercontent.com/YOURUSER/YOURREPO/data/tide.bin"
//
// Or a laptop/Pi on your LAN running `python3 -m http.server 8000`:
//   "http://192.168.1.50:8000/tide.bin"

#define IMAGE_URL  "https://raw.githubusercontent.com/YOURUSER/YOURREPO/data/tide.bin"
